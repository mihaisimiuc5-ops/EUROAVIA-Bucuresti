{
  "appId": "ro.euroaviabucuresti.app",
  "appName": "Euroavia Bucuresti",
  "webDir": "www",
  "bundledWebRuntime": false,
   "plugins": {
    "GoogleAuth": {
      "scopes": ["profile", "email"],
      "serverClientId": "440151498628-lh87c1pfc7asgrohle857uls25jvnkvu.apps.googleusercontent.com",
      "forceCodeForRefreshToken": true
    },
    "SplashScreen": {
      "launchShowDuration": 2500,
      "launchAutoHide": true,
      "backgroundColor": "#003366",
      "androidSplashResourceName": "splash",
